{"repo": {"name": {"en-US": "GLPenFind"}, "description": {"en-US": "Independent UK price index for private weight-care pens. Every pharmacy that publishes a price, per dose, with the date it was read."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "24b9ce72216c5d8cac5d56ebf548ad9c46313f48b4ccf311667b93dd01cb1067", "size": 831}}, "address": "https://vedarjos.github.io/glpenfind-fdroid/repo", "timestamp": 1794772297000, "categories": {"Sports & Health": {"name": {"en-US": "Sports & Health"}}}}, "packages": {"uk.whimsical.glpenfind": {"metadata": {"added": 1794604181000, "categories": ["Sports & Health"], "issueTracker": "https://github.com/vedarjos/glpenfind/issues", "lastUpdated": 1794772297000, "license": "GPL-3.0-or-later", "sourceCode": "https://github.com/vedarjos/glpenfind", "webSite": "https://vedarjos.github.io/", "authorName": "Petroula Kostofska", "name": {"en-US": "GLPenFind"}, "summary": {"en-US": "UK weight-care prices from every registered pharmacy"}, "description": {"en-US": "GLPenFind is an independent price index for private weight-care pens in the\nUK. It lists what each registered pharmacy publishes for a consultation, per\ndose, and links every figure to the page it came from.\n\nEvery pharmacy is listed at every dose. Where a pharmacy publishes no price\nfor a dose, the card says so rather than hiding it, so the gaps are visible\ninstead of silently dropped.\n\nThe home-screen widget shows the cheapest published price at your chosen dose\nand the date it was read, straight from the bundled index — no network, no\naccount, nothing stored about you."}, "preferredSigner": "79a1f72a86a44555818e8c48312771960a96280bd94ddc341dc25092946d3a1d"}, "versions": {"4a3d81948f91b614fe82d64dbd71553f58d689e229d0b195873687815008a72a": {"added": 1794772297000, "file": {"name": "/GLPenFind-1.3.apk", "sha256": "4a3d81948f91b614fe82d64dbd71553f58d689e229d0b195873687815008a72a", "size": 5430240}, "manifest": {"versionName": "1.3", "versionCode": 4, "usesSdk":