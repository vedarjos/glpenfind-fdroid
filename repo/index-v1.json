{"repo": {"timestamp": 1794939426000, "version": 20002, "name": "GLPenFind", "icon": "icon.png", "address": "https://vedarjos.github.io/glpenfind-fdroid/repo", "description": "Independent UK price index for private weight-care pens. Every pharmacy that publishes a price, per dose, with the date it was read."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorName": "Petroula Kostofska", "categories": ["Sports & Health"], "suggestedVersionCode": "6", "description": "GLPenFind is an independent price index for private weight-care pens in the\nUK. It lists what each registered pharmacy publishes for a consultation, per\ndose, and links every figure to the page it came from.\n\nEvery pharmacy is listed at every dose. Where a pharmacy publishes no price\nfor a dose, the card says so rather than hiding it, so the gaps are visible\ninstead of silently dropped.\n\nThe home-screen widget shows the cheapest published price at your chosen dose\nand the date it was read, straight from the bundled index \u2014 no network, no\naccount, nothing stored about you.", "issueTracker": "https://github.com/vedarjos/glpenfind/issues", "license": "GPL-3.0-or-later", "sourceCode": "https://github.com/vedarjos/glpenfind", "summary": "UK weight-care prices from every registered pharmacy", "webSite": "https://vedarjos.github.io/", "added": 1794604181000, "packageName": "uk.whimsical.glpenfind", "lastUpdated": 1794939426000, "localized": {"en-US": {"name": "GLPenFind"}}}], "packages": {"uk.whimsical.glpenfind": [{"added": 1794939426000, "apkName": "GLPenFind-1.5.apk", "hash": "110e8a0672756df295e813b7a45a709956cad165c99d5f6d7225db383aa04454", "hashType": "sha256", "minSdkVersion": 24, "packageName": "uk.whimsical.glpenfind", "sig": "0b1cc6c99bbad764a66edbc73eadc921", "signer": "79a1f72a86a44555818e8c48312771960a96280bd94ddc341dc25092946d3a1d", "size": 5610391, "targetSdkVersion": 36, "uses-permission": [["android.permission.INTERNET", null], ["uk.whimsical.glpenfind.DYNAMIC_RECEIV